{
  "name": "aibootcamp-capstone",
  "private": true,
  "description": "First 90 — an AI-assisted onboarding accelerator for the first 90 days in a new role, built as an AI Bootcamp capstone.",
  "workspaces": [
    "app",
    "services/*",
    "mcp/*"
  ],
  "scripts": {
    "check:traceability": "tsx scripts/check-traceability.ts",
    "lint": "npm run lint --workspace app --if-present",
    "typecheck": "npm run typecheck --workspace app --if-present",
    "test": "npm run test --workspace app --if-present",
    "build": "npm run build --workspace app --if-present",
    "test:e2e": "npm run test:e2e --workspace app --if-present"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "prisma": {
    "schema": "app/prisma/schema.prisma"
  },
  "overrides": {
    "postcss": "8.5.28",
    "next": {
      "postcss": "8.5.28"
    }
  }
}
